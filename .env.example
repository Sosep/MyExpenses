# Copy this file to .env (gitignored) so `docker compose run --rm android-build ...`
# works without exporting anything. .env is read by compose automatically.
# On this host the login user is uid 1001; run `id -u` / `id -g` to confirm yours.
# With HOST_UID/HOST_GID set here, compose passes them into the container and
# the entrypoint aligns the image's baked home directory and Gradle cache with
# these ids (root start, then setpriv drop), so gradle in the container matches
# the repo owner (no "dubious ownership") and can write /gradle-cache.
HOST_UID=1001
HOST_GID=1001
